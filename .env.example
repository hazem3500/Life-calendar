# In-app feedback relay (/api/feedback). Without the first two, reports answer 503 "not set up yet".
FEEDBACK_WEBHOOK_URL=          # minted Kody webhook URL for the life-calendar intake
FEEDBACK_HMAC_SECRET=          # same value as Kody's feedbackHmacLifeCalendar secret
FEEDBACK_OWNER_KEYS=[]         # JSON array of approved owner-device public keys (shown on /owner)
FEEDBACK_ALLOWED_ORIGINS=      # optional, comma-separated; default is the site's own origin
